# Pick a UTF-8 locale that actually exists on this machine. Hardcoding
# en_US.UTF-8 silently falls back to POSIX/C in minimal containers (e.g.
# Docker images that only ship C.UTF-8), which breaks UTF-8 rendering in
# tmux (non-ASCII glyphs show up as `_`).
__pick_utf8_locale() {
  if command -v locale >/dev/null 2>&1; then
    __avail=$(locale -a 2>/dev/null)
    for __cand in en_US.UTF-8 en_US.utf8 C.UTF-8 C.utf8; do
      case "$__avail" in
        *"$__cand"*) printf '%s' "$__cand"; return 0 ;;
      esac
    done
  fi
  printf '%s' C.UTF-8
}
__utf8_locale=$(__pick_utf8_locale)
export LANG="$__utf8_locale"
export LC_CTYPE="$__utf8_locale"
unset __utf8_locale
unset -f __pick_utf8_locale 2>/dev/null || true

export EDITOR="zed"
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.orbstack/bin:$PATH"

# pi coding agent — extended prompt cache (Anthropic: 1h, OpenAI: 24h)
export PI_CACHE_RETENTION=long

# Share AGENTS.md with GitHub Copilot CLI.
# Copilot discovers ~/.agents/skills automatically; AGENTS.md needs this path.
__agent_instructions_dir="$HOME/.agents"
if [ -f "$__agent_instructions_dir/AGENTS.md" ]; then
  case ",${COPILOT_CUSTOM_INSTRUCTIONS_DIRS:-}," in
    *,"$__agent_instructions_dir",*) ;;
    *) export COPILOT_CUSTOM_INSTRUCTIONS_DIRS="$__agent_instructions_dir${COPILOT_CUSTOM_INSTRUCTIONS_DIRS:+,$COPILOT_CUSTOM_INSTRUCTIONS_DIRS}" ;;
  esac
fi
unset __agent_instructions_dir

if command -v gh >/dev/null 2>&1; then
  __github_token="$(gh auth token 2>/dev/null)"
  if [ -n "$__github_token" ]; then
    export GITHUB_TOKEN="$__github_token"
  fi
  unset __github_token
fi

alias g="git"

# --- Pi launcher -------------------------------------------------------------
# Host: stock pi. Isolation is the Gondolin extension (built-in tools in a
# local micro-VM). Codespaces: already a disposable container, so run pi
# natively in tmux.
# Note: this file is sourced by both zsh and bash, so keep it portable
# (use arrays, not unquoted word-splitting, which zsh does not do).

# In Codespaces, launch interactive Pi inside tmux automatically.
# Reattach to the existing Pi tmux session when one already exists.
# Run short-lived/non-interactive pi commands directly so tmux doesn't
# briefly attach and leak terminal probe replies back into the parent shell.
if [ "${CODESPACES:-}" = "true" ] || [ -n "${CODESPACE_NAME:-}" ]; then
  export NPM_CONFIG_PREFIX="$HOME/.local"

  __pi_should_run_directly() {
    case "${1:-}" in
      -h|--help|-v|--version|-p|--print|--export|--list-models|config|install|remove|uninstall|update|list)
        return 0
        ;;
    esac

    return 1
  }

  pi() {
    if [ -n "${TMUX:-}" ] || ! command -v tmux >/dev/null 2>&1 || [ ! -t 0 ] || [ ! -t 1 ] || __pi_should_run_directly "${1:-}"; then
      command pi "$@"
      return
    fi

    local session_name="${PI_TMUX_SESSION_NAME:-pi-codespace}"
    local pi_command="exec pi"
    local arg
    for arg in "$@"; do
      pi_command="${pi_command} $(printf '%q' "$arg")"
    done

    if command tmux has-session -t "$session_name" 2>/dev/null; then
      command tmux attach-session -t "$session_name"
      return
    fi

    local interactive_shell="sh"
    if [ -n "${ZSH_VERSION:-}" ]; then
      interactive_shell="zsh"
    elif [ -n "${BASH_VERSION:-}" ]; then
      interactive_shell="bash"
    fi

    command tmux new-session -s "$session_name" -c "$PWD" "$interactive_shell -ic $(printf '%q' "$pi_command")"
  }
fi

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section
